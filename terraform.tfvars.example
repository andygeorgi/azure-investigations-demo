# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is excluded from git via .gitignore.
#
# All resource names are derived from name_prefix (default: "amw-iidemo").
# Change the prefix to deploy multiple instances side by side.
# See variables.tf for full list of available options.

# name_prefix = "amw-iidemo"
# location    = "westeurope"

# Scenario selection
# Available scenarios:
#   - availability-url-failure   (implemented, default)
#   - vm-connectivity-loss       (implemented)
#   - appgw-backend-unhealthy    (implemented)
enabled_scenarios = ["availability-url-failure"]

# Notification target
alert_email = "you@example.com"

# Availability URL Failure scenario — URL to probe
webtest_url = "https://your-app.example.com"

# Incident triggers — toggle to true to simulate incidents
vm_connectivity_block_outbound_443 = false
appgw_block_backend_health_probe   = false
